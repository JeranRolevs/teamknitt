include README.md LABTUNE.md AGENTS.md LICENSE LICENSING.md
recursive-include src/labtune/resources *.yaml *.json *.md *.py *.html *.css *.js
recursive-include src/labtune/schemas *.json
recursive-include src/teamknitt/resources *.yaml *.json *.md *.html *.js
recursive-include lab_designs *.md
recursive-include configs *.yaml *.md
recursive-include prompts *.md
recursive-include templates *.yaml *.md *.json
recursive-include examples *.py *.md *.yaml
recursive-include tools *.py
recursive-include diagrams *.py *.mmd *.svg
recursive-include docs *.md *.json
global-exclude __pycache__ *.py[cod] private_splits.json .env .env.*
global-exclude TEAMKNITT_FOUNDATIONS.md [Ff]oundations* [Ff]undations*
prune setup
prune trials
prune results
prune data
prune local-reference
prune archive
exclude docs/CODE_PROVENANCE_AUDIT.md docs/provenance_audit.json
exclude RELATED_WORK_REVIEW.md REVIEW.md PLAN.md idea_flow.md
