{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "teamknitt lab-design front matter v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "governance": {
      "type": "string",
      "minLength": 1
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "prime",
              "coordinator"
            ]
          },
          "approach": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "role",
          "approach"
        ],
        "additionalProperties": false
      }
    },
    "collaboration": {
      "type": "object",
      "properties": {
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "procedure",
        "phases",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "communication": {
      "type": "object",
      "properties": {
        "recommended": {
          "type": "object",
          "properties": {
            "detail": {
              "enum": [
                "none",
                "low",
                "intermediate",
                "high"
              ]
            },
            "wisdom": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "enabled"
              ],
              "additionalProperties": false
            },
            "mechanisms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "detail",
            "wisdom",
            "mechanisms"
          ],
          "additionalProperties": false
        },
        "on_restriction": {
          "const": "adapt_without_escalation"
        }
      },
      "required": [
        "recommended",
        "on_restriction"
      ],
      "additionalProperties": false
    },
    "meetings": {
      "type": "object",
      "properties": {
        "recommended": {
          "type": "boolean"
        },
        "facilitator": {
          "type": "string",
          "minLength": 1
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_words": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "recommended",
        "max_rounds",
        "max_total_words"
      ],
      "additionalProperties": false
    },
    "delegation": {
      "type": "object",
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_children_per_agent": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "const": "inherited"
        }
      },
      "required": [
        "max_depth",
        "max_children_per_agent",
        "budget"
      ],
      "additionalProperties": false
    },
    "decision_tools": {
      "const": "inherit"
    },
    "model": {
      "const": "inherit"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "governance",
    "personas",
    "collaboration",
    "communication",
    "meetings",
    "delegation",
    "decision_tools",
    "model"
  ],
  "additionalProperties": false
}
