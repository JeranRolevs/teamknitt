{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "teamknitt skeleton configuration v1",
  "type": "object",
  "properties": {
    "single_scientist": {
      "type": "object",
      "properties": {
        "persistence": {
          "enum": [
            "low",
            "medium",
            "persistent"
          ]
        },
        "sequences": {
          "type": "integer",
          "minimum": 1
        },
        "effort_mode": {
          "enum": [
            "fixed_passes",
            "budget"
          ]
        },
        "context_policy": {
          "enum": [
            "continue",
            "fresh_sequence"
          ]
        }
      },
      "required": [
        "persistence",
        "sequences",
        "effort_mode",
        "context_policy"
      ],
      "additionalProperties": false
    },
    "schema_version": {
      "const": 1
    },
    "lab": {
      "type": "object",
      "properties": {
        "design_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "design_file"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "name"
      ],
      "additionalProperties": false
    },
    "teams": {
      "type": "object",
      "properties": {
        "role_instances": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "max_depth": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_children_per_agent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_active_descendants": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "role_instances",
        "max_depth",
        "max_children_per_agent",
        "max_active_descendants"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "max_active_agents": {
          "type": "integer",
          "minimum": 1
        },
        "max_llm_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_experiments": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_active_agents",
        "max_llm_requests",
        "max_experiments"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_llm_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_evaluations": {
          "type": "integer",
          "minimum": 1
        },
        "confirmation_evaluations_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_llm_calls",
        "max_evaluations",
        "confirmation_evaluations_reserved",
        "max_wall_seconds"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "independent_paths": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "refinement_steps": {
          "type": "integer",
          "minimum": 1
        },
        "candidates_per_step": {
          "type": "integer",
          "minimum": 1
        },
        "context_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "independent_paths",
        "refinement_steps",
        "candidates_per_step",
        "context_policy"
      ],
      "additionalProperties": false
    },
    "communication": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "preset",
            "none",
            "low",
            "intermediate",
            "high",
            "wisdom_only"
          ]
        },
        "wisdom": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "cadence": {
          "enum": [
            "episode_boundary",
            "scheduled_checkpoint"
          ]
        },
        "max_read_words": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "profile",
        "wisdom",
        "cadence",
        "max_read_words"
      ],
      "additionalProperties": false
    },
    "meetings": {
      "type": "object",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_rounds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max_total_words": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "max_rounds",
        "max_total_words"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "llm_only",
            "shadow",
            "selected_active"
          ]
        },
        "specialist": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_specs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agent_access": {
          "type": "boolean"
        },
        "max_calls_per_episode": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "specialist",
        "allowed_specs",
        "agent_access",
        "max_calls_per_episode"
      ],
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "mission_file": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "adapter",
        "mission_file"
      ],
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "properties": {
        "approach": {
          "enum": [
            "frequentist"
          ]
        }
      },
      "required": [
        "approach"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "lab",
    "model",
    "teams",
    "resources",
    "budget",
    "search",
    "communication",
    "meetings",
    "decisions",
    "domain",
    "statistics"
  ],
  "additionalProperties": false
}
