{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User-configured teams for one shared task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "task",
    "budget",
    "resources",
    "communication",
    "teams"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_file",
        "deliverable"
      ],
      "properties": {
        "brief_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "deliverable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_llm_calls",
        "max_wall_seconds"
      ],
      "properties": {
        "max_llm_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_active_agents",
        "max_llm_requests"
      ],
      "properties": {
        "max_active_agents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_llm_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "max_read_words",
        "links"
      ],
      "properties": {
        "profile": {
          "enum": [
            "none",
            "summaries",
            "contributions"
          ]
        },
        "max_read_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "links": {
          "type": "array",
          "maxItems": 56,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "target": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              }
            }
          }
        }
      }
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "configuration_file",
          "study_file",
          "style",
          "exporter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "configuration_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "study_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "file",
              "authorship",
              "references"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "file": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  }
                ]
              },
              "authorship": {
                "enum": [
                  null,
                  "user_authored"
                ]
              },
              "references": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "url",
                    "revision"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "revision": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "exporter": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
              }
            ]
          }
        }
      }
    }
  }
}
