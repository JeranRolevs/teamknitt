%% Generated from specs.py; 2026-10-31. Current runtime; gray nodes are planned.
flowchart LR
    generation["Model authors policy source<br/>Configured model + actor provenance"]
    validate["Source/API validation<br/>select(bank, ages, new, t, capacity, aux)"]
    supervisor["Trusted supervisor<br/>Score current x against OLD bank"]
    worker["OS-sandboxed policy<br/>Causal x,t; retained indices + aux<br/>No labels, seeds or future"]
    chat_judge["Optional decision backend<br/>Configured chat or typed endpoint"]
    panels["Private scenario panels<br/>Clean calibration / benign / fault<br/>Development separate from confirmation"]
    metrics["Independent-run evaluation<br/>Any-alarm rate, fault recall, recurrence<br/>CP95 / supported count intervals"]
    receipts["Actual experiment receipts<br/>Source hash, counts, state, RSS and time"]
    feedback["Development feedback<br/>Within declared research budget"]
    output["Source + evidence + limits<br/>Include failed / inconclusive outcomes"]
    confirm["One reserved confirmation<br/>Fixed source; fresh clean calibration<br/>Never feedback to the acting agents"]
    generation --> validate
    validate --> supervisor
    supervisor -->|causal input| worker
    worker -->|retained indices + aux| supervisor
    panels --> supervisor
    supervisor --> metrics
    metrics --> receipts
    generation -.-> chat_judge
    chat_judge -.-> generation
    receipts -->|development only| feedback
    feedback --> generation
    receipts --> confirm
    confirm --> output
