    stats["User-selected statistics<br/>CP95 counts; explicit-prior intervals<br/>Domain-owned analysis"]
    future["General asset lifecycle<br/>Integration and registry planned"]
    setup --> control
    control --> teams
    teams --> run
    run --> confirm
    confirm --> out
    user --> setup
    settings --> control
    sharing --> teams
    decision -.-> run
    stats --> confirm
    out -.-> future
