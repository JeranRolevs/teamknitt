%% Generated from specs.py; 2026-10-31. Current runtime; gray nodes are planned.
flowchart LR
    setup["Choose mission + lab<br/>Six editable Markdown styles"]
    control["Orchestrate<br/>Dependencies + global budgets"]
    teams["Configured researchers<br/>One scientist or bounded teams"]
    run["Execute and measure<br/>Qualified local sandbox + evaluator"]
    confirm["Confirm candidate<br/>Reserved; no agent feedback"]
    out["Candidate + receipts<br/>Measured tradeoffs and limits"]
